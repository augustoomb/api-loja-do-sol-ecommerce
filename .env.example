POSTGRES_DB=loja_do_sol
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha

DB_URL=jdbc:postgresql://localhost:5432/loja_do_sol
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha

# Gere com: openssl rand -hex 64
JWT_SECRET=sua_chave_secreta_jwt

# Admin inicial criado automaticamente no primeiro boot (se não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=sua_senha_forte

# Origens do front-end permitidas no CORS (separadas por vírgula, ex: http://localhost:5173,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Stripe (chaves de teste: https://dashboard.stripe.com/test/apikeys)
# STRIPE_SIMULATE=true desativa chamadas reais ao Stripe e usa o fluxo simulado
STRIPE_SECRET_KEY=sua_chave_secreta_stripe
STRIPE_WEBHOOK_SECRET=sua_chave_secreta_webhook_stripe
STRIPE_SIMULATE=true

# URL base do front-end usada nas URLs de sucesso/cancelamento do checkout
FRONTEND_URL=http://localhost:5173

